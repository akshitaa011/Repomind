# RepoMind Environment Variables Configuration
# Copy this file to .env.local for local development

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (Required for auth pages and user session)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Razorpay Payment Gateway (Test Mode / Free)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Google Gemini AI (For code embeddings & Q&A)
GEMINI_API_KEY="your-gemini-api-key"

# GitHub Integration (Optional - for increased GitHub API rate limits)
GITHUB_ACCESS_TOKEN="your-github-pat"

# Database (PostgreSQL with pgvector - Supabase / Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
SKIP_ENV_VALIDATION=true
